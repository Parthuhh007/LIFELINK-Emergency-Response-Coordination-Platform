# LIFELINK Environment Configuration

# Application
APP_NAME=LIFELINK
APP_ENV=development
PORT=8000
DEBUG=True

# Database (PostgreSQL or SQLite)
# For local zero-setup dev:
DATABASE_URL=sqlite+aiosqlite:///./lifelink.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lifelink

# Security & JWT
JWT_SECRET=lifelink_super_secure_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Real Geography & Maps Provider
# Options: "osrm" (default, free live real road routing), "mapbox", "google"
MAPS_PROVIDER=osrm
MAPBOX_API_KEY=
GOOGLE_MAPS_API_KEY=

# Digital Twin Simulation
SIMULATION_ENABLED=True
SIMULATION_TICK_SECONDS=3.0
SIMULATION_CITY=Chicago, IL
